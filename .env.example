# Copia este archivo como .env y completa con los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API). La clave "anon" es pública por diseño:
# la seguridad la dan las políticas RLS de supabase/schema.sql.
# NUNCA subas la clave "service_role" al repositorio.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon
